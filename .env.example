# API Configuration
VITE_API_URL=

# GitHub Token for submission storage (required for production)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GH_TOKEN=

# Admin Secret for server-side API auth (KEEP PRIVATE)
ADMIN_SECRET=

# Comma separated list of allowed admin usernames (optional). If set, requests must include x-admin-user header that matches.
ADMIN_ALLOWED_USERS=

# Admin Password for dashboard UI login (REQUIRED)
VITE_ADMIN_PASSWORD=

# Comma separated list of allowed admin usernames for UI login (optional)
VITE_ADMIN_USERS=
